# Shared configuration for model-backed lessons.
# The root agent:demo command does not need these values.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

# Optional embedding configuration used by RAG lessons.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL_NAME=
EMBEDDINGS_DIMENSIONS=

# Required only by the MySQL-backed mini-cursor lessons.
MYSQL_PASSWORD=replace-with-your-local-database-password
