# Shared configuration for model-backed lessons.
# The root agent:demo command does not need these values.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

# Optional Langfuse tracing for the root agent runner.
# Create keys in Langfuse project settings; leave blank to run offline.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=agent-engineering-lab

# Optional embedding configuration used by RAG lessons.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL_NAME=
EMBEDDINGS_DIMENSIONS=

# Required only by the MySQL-backed mini-cursor lessons.
MYSQL_PASSWORD=replace-with-your-local-database-password
