# ============================================================
# AI Agent 学习项目统一 ignore
# 维护原则：lesson 子目录不再单独维护 .gitignore
# ============================================================

**/node_modules/
**/dist/
**/.env
**/.env.*
!.env.example

npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

.DS_Store
Thumbs.db

# Workspace package manifests are source files and must remain visible to Git.
**/pnpm-lock.yaml
**/package-lock.json
**/yarn.lock

!/pnpm-lock.yaml
!/package-lock.json
!/yarn.lock

# Runtime-generated agent traces and lesson audio.
/output/
/lessons/21_tts-stt-test/output.mp3
/lessons/21_tts-stt-test/output3.mp3

.pnpm-store/

# Large binary files
*.epub
